# Vídeos de demostración (pesan mucho; se pueden subir aparte)
videos/

# Cachés de los scripts de descarga
tools/cache/
__pycache__/

# Firebase / emulador / logs
.firebase/
*-debug.log
*.log
node_modules/

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# Capturas de tela geradas pelos testes de browser (não são assets do jogo).
# Os PNGs de conteúdo do jogo ficam em assets/ e são versionados normalmente.
/*.png
!assets/*.png
!assets/**/*.png
/shots/

# Contactos privados (emails de terceros): nunca al repositorio público
docs/CONTACTOS_CREADORES.md

# Chaves de API e scripts locais de ambiente
.env
.env.*
run-claude.bat
run-claude.ps1
iniciar_claude_opus.bat
tools/ask_claude.js

# Caché local de wrangler (Cloudflare)
.wrangler/

# Estado local do Agent Manager (worktrees, sessões, agent-manager.json).
# É estado de execução da máquina, não faz parte do jogo.
.kilo/
